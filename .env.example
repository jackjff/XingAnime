NODE_ENV=development

# Xing API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Sanka provider
SANKA_BASE_URL=https://www.sankavollerei.web.id
SANKA_INTERNAL_BUDGET_PER_MINUTE=18
SANKA_MIN_REQUEST_INTERVAL_MS=3500
SANKA_REQUEST_CONCURRENCY=1
SANKA_MAX_RETRIES=1
SANKA_CACHE_TTL_HOME_SECONDS=600
SANKA_CACHE_TTL_DETAIL_SECONDS=86400
SANKA_CACHE_TTL_EPISODES_SECONDS=43200
SANKA_CACHE_TTL_PLAYBACK_SECONDS=180
SANKA_SYNC_INTERVAL_SECONDS=1800
SANKA_SYNC_LEASE_TTL_SECONDS=300

# PostgreSQL
POSTGRES_DB=xing_anime
POSTGRES_USER=xing_anime
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://xing_anime:change-me@postgres:5432/xing_anime

# Redis
REDIS_URL=redis://redis:6379

# Directus
DIRECTUS_PORT=8055
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-now
DIRECTUS_SECRET=replace-with-a-long-random-secret
